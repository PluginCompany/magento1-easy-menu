<?xml version="1.0"?>
<config>
    <modules>
        <Plugincompany_Easymenu>
            <version>1.1.3</version>
        </Plugincompany_Easymenu>
    </modules>
    <global>
        <helpers>
            <easymenu>
                <class>Plugincompany_Easymenu_Helper</class>
            </easymenu>
        </helpers>
        <blocks>
            <easymenu>
                <class>Plugincompany_Easymenu_Block</class>
            </easymenu>
            <page>
                <rewrite>
                    <html_topmenu>Plugincompany_Easymenu_Block_Page_Html_Topmenu</html_topmenu>
                </rewrite>
            </page>
        </blocks>
        <models>
            <easymenu>
                <class>Plugincompany_Easymenu_Model</class>
                <resourceModel>easymenu_mysql4</resourceModel>
            </easymenu>
            <easymenu_mysql4>
                <class>Plugincompany_Easymenu_Model_Mysql4</class>
                <entities>
                    <easymenu>
                        <table>plugincompany_easymenu</table>
                    </easymenu>
                </entities>
            </easymenu_mysql4>
        </models>
        <resources>
            <plugincompany_easymenu_setup>
                <setup>
                    <module>Plugincompany_Easymenu</module>
                </setup>
                <connection>
                    <use>core_setup</use>
                </connection>
            </plugincompany_easymenu_setup>
            <plugincompany_easymenu_write>
                <connection>
                    <use>core_write</use>
                </connection>
            </plugincompany_easymenu_write>
            <plugincompany_easymenu_read>
                <connection>
                    <use>core_read</use>
                </connection>
            </plugincompany_easymenu_read>
        </resources>
    </global>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <Plugincompany_Easymenu before="Mage_Adminhtml">Plugincompany_Easymenu_Adminhtml</Plugincompany_Easymenu>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <adminhtml>
        <events>
            <cms_page_save_after>
                <observers>
                    <plugincompany_easymenu>
                        <type>model</type>
                        <class>easymenu/observer</class>
                        <method>cmsSaveAfter</method>
                    </plugincompany_easymenu>
                </observers>
            </cms_page_save_after>
            <catalog_category_save_after>
                <observers>
                    <plugincompany_easymenu>
                        <type>model</type>
                        <class>easymenu/observer</class>
                        <method>catalogCategorySaveAfter</method>
                    </plugincompany_easymenu>
                </observers>
            </catalog_category_save_after>
        </events>
        <menu>
            <system>
                <children>
                    <easymenubackend module="easymenu">
                        <title>Manage Easy Menu</title>
                        <sort_order>110</sort_order>
                        <action>adminhtml/easymenubackend</action>
                    </easymenubackend>
                </children>
            </system>
        </menu>
        <acl>
            <resources>
                <all>
                    <title>Allow Everything</title>
                </all>
                <admin>
                    <children>
                        <system>
                            <children>
                                <easymenubackend translate="title">
                                    <title>Manage Easy Menu</title>
                                    <sort_order>1100</sort_order>
                                </easymenubackend>
                            </children>
                        </system>
                    </children>
                </admin>
            </resources>
        </acl>
        <layout>
            <updates>
                <easymenu>
                    <file>easymenu.xml</file>
                </easymenu>
            </updates>
        </layout>
    </adminhtml>
</config> 
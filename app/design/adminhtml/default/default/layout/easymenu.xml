        </block>
        <block type="core/template" template="easymenu/controls.phtml" />
	  <block type="easymenu/adminhtml_easymenubackend" name="easymenubackend" template="easymenu/easymenubackend.phtml"/>
	</reference>
  </adminhtml_easymenubackend_index>

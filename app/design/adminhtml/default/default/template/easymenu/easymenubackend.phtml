<script type="text/javascript">
    var itemsToDrop;
    var currentGrid;
    var categoryDetails = {};
    var productDetails = {};
    var cmsPageDetails = {};
    var categorySuffix = '<?php echo $this->getCategorySuffix();?>';

    jQuery(document).ready(function(){
        updateProductDetails();
        updateCmsPageDetails();
        updateCatagoryDetails();

        jQuery('#loadStoreMenu')
            .html(jQuery('#store_switcher').html())
        ;
        jQuery('#loadStoreMenu option[value=<?php echo $this->getStoreId();?>]').remove();

        jQuery.ionTabs("#tabs_1");
        jQuery('.disabled>div').unwrap().remove();
        jQuery('.sortable').nestedSortable({
            connectWith: ['#mainsortable','#customlinksortable'],
            isAllowed: function(item,parent) {
                if(parent == null) {
                    return false;
                }
                if(jQuery(item[0]).hasClass('psort')){
                    return false;
                }
                if(jQuery(parent[0]).hasClass('dontdrop')){
                    return false;
                }
                var classname = jQuery(item[0]).attr('class');
                if(!jQuery(parent[0]).hasClass(classname)){
                    //     return false;
                }

                return true;
            },
            update: function( event, ui )
            {
                if(jQuery(ui['item']).hasClass('psort')) {
                    return false;
                }
                if(jQuery(ui['item']).hasClass('scat') && jQuery(ui['item']).parents('#scms').length > 0 ) {
                    if(jQuery(ui['item']).get(0).tagName == "OL") {
                        jQuery(ui['item']).appendTo(jQuery('#scategories:eq(0)'));
                    }else {
                        jQuery(ui['item']).appendTo(jQuery('#scategories:eq(0)')).wrap('<ol />');
                    }
                }
                if(jQuery(ui['item']).hasClass('scms') && jQuery(ui['item']).parents('#scategories').length > 0 ) {
                    if(jQuery(ui['item']).get(0).tagName == "OL") {
                        jQuery(ui['item']).appendTo(jQuery('#scms:eq(0)'));
                    }else {
                        jQuery(ui['item']).appendTo(jQuery('#scms:eq(0)')).wrap('<ol />');
                    }
                }

            },

            handle: 'div',
            items: 'li',
            tolerance: 'pointer',
            toleranceElement: '> div',
            protectRoot: true,
            forcePlaceholderSize: true,
            helper:	'clone',
            opacity: .6,
            placeholder: 'placeholder',
            revert: 250,
            tabSize: 25,
            maxLevels: 0,
            isTree: true,
            expandOnHover: 700,
            startCollapsed: true
        });
        jQuery('.disclose').on('click', function() {
            jQuery(this).closest('li').toggleClass('mjs-nestedSortable-collapsed').toggleClass('mjs-nestedSortable-expanded');
        });

        jQuery('#save').click(function() {
            new Ajax.Request('<?php echo Mage::helper("adminhtml")->getUrl('*/*/save', array('_current'=>true)); ?>',{
                parameters: {menu: generateArray()},
                onComplete: function(response) {
                    var response = jQuery.parseJSON(response.responseText);
                    showMessage(response[0], response[1]);
                }
            });

        });

        jQuery('#delete').click(function() {
            new Ajax.Request('<?php echo Mage::helper("adminhtml")->getUrl('*/*/delete', array('_current'=>true)); ?>',{
                onComplete: function(response) {
                    location.reload();
                }
            });

        });

        jQuery('#menu').removeClass('mjs-nestedSortable-leaf').addClass('mjs-nestedSortable-expanded').addClass('mjs-nestedSortable-branch');

        jQuery('#smenu span.title').after(getToolButtons());

    });
    var i = 1;
    jQuery('.sortable li').each(function () {
        if(jQuery(this).attr('id') == false) {
            jQuery(this).attr('id', 'item'+i);
            i++;
        }
    });

    jQuery('#create_custom_link').click(function()
        {
            var newSortable = '<li class="scustom " mtitle="#title#" murl="#url#" mtype="3" mid="" style="display: list-item;"><div><span class="disclose"><span></span></span><span class="title">#title#</span></div></li>'
            newSortable = newSortable.replace(/#url#/g, jQuery('#custom_link_url').val());
            newSortable = newSortable.replace(/#title#/g, jQuery('#custom_link_title').val());
            jQuery('#scustom').append(newSortable);
        }
    )


    function showMessage(txt, type) {
        var html = '<ul class="messages"><li class="'+type+'-msg"><ul><li>' + txt + '</li></ul></li></ul>';
        jQuery('#messages')
            .hide()
            .fadeIn()
            .html(html)
            .delay(5000)
            .fadeOut();
    }

    function generateArray() {
        var menuArr = [];
        var i = 1;
        jQuery('#smenu li').each(function() {
            var generateNav = '';
            var url = "";

            if(jQuery(this).attr('mtype') != 3){
                jQuery(this).parents('li.menuitem').not(jQuery('#smenu')).each(function ()
                {
                    if(jQuery(this).attr('murl')) {
                        url = jQuery(this).attr('murl') + "/" + url;
                    }
                });
            }

            generateNav += jQuery(this).parent().children('li.menuitem').index(jQuery(this))+1+"-";

            url += jQuery(this).attr('murl');

            var islast      = false;
            if(jQuery(this).parent().children('li.menuitem').length-1 == jQuery(this).parent().children('li.menuitem').index(jQuery(this))) {
                islast = 1;
            }

            var depth       = jQuery(this).parents('ol').length;
            var title       = jQuery(this).attr('mtitle');
            var index       = jQuery(this).parent().children('li.menuitem').index(jQuery(this));
            var id          = jQuery(this).attr('mid');
            var type        = jQuery(this).attr('mtype');
            var haschildren = jQuery(this).children('ol').children().length;
            var nestedUrl   = jQuery(this).attr('mrewrite');
            var nav         = generateNav;
            var link        = jQuery(this).attr('murl');
            var customTitle = jQuery(this).attr('usecustomtitle');

            menuArr.push({
                depth: depth,
                drawNumber: i,
                index: index,
                title: title,
                id: id,
                type: type,
                hasChildren: haschildren,
                nav: nav,
                isLast:islast,
                link: link,
                deepLink: url,
                useDeepLink: nestedUrl,
                useCustomTitle: customTitle
            });
            i++;
        });
        return JSON.stringify(menuArr);
    };

    function showItemDetails(btn) {
        var details;
        var menuItem = jQuery(btn).closest('li.menuitem');

        //if details div already exists, use that one
        if(menuItem.children('.mItemDetails').length) {
            details = menuItem.children('.mItemDetails');
        }else{
            //create new details div
            var details = jQuery(getItemDetailsHtml(menuItem));
        }
        menuItem.children('div').first().after(details);
        updateCustomTitleEditable();
        if(details.is(':hidden')) {
            details.fadeIn();
        }else{
            details.fadeOut();
        }
    }

    function getItemDetailsHtml(item) {
        var html = '<div class="mItemDetails"><div><table cellpadding="2">';

        var urltext;
        var typeTitle;
        var type = item.attr('mtype');
        var urlEditable = " disabled='disabled' ";

        if(type == 1){
            typeTitle = "Category";
            urltext = 'URL Key ';
        }
        if(type == 2){
            typeTitle = "CMS Page";
            urltext = 'URL Key ';
        }
        if(type == 3){
            typeTitle = "Custom Link";
            urltext = 'Full URL ';
            urlEditable = "";
        }
        if(type == 4){
            typeTitle = "Product";
            urltext = 'URL Key ';
        }

        if(item.attr('mtype') != "3"){
            html += "<tr><td><label>Original Title </label></td><td><input disabled='disabled' class='' value='" + item.attr('moriginaltitle') + "' /></td></tr>";
        }
        html += "<tr><td><label>Custom Title </label></td><td style='position:relative'><input class='mtitle' value='" + item.attr('mtitle') + "' />";
        
        if(item.attr('mtype') != "3"){
            var checked = " checked='checked' ";
            if(item.attr('usecustomtitle') != '1'){
                checked = '';
            }
            html += "<span class='input-addon'><input title='check this box to use a custom title' onclick='updateCustomTitleEditable()' class='useCustomTitle' type='checkbox' " + checked + "/></span>";
        }
        html += "</td></tr>";
        html += "<tr><td><label>" + urltext + "</label></td><td><input " + urlEditable + " class='murl' value='" + item.attr('murl') + "' /></td></tr>";

        html += "<tr><td><label>Item Type </label></td><td><p>" + typeTitle + "</p></td></tr>";

        if(type != 3){
            var checked = "";
            if(typeof item.attr('mrewrite') !== "undefined" && item.attr('mrewrite') == 1){
                checked = " checked='checked' ";
            }
            html += "<tr><td><label>Nested URL <span onclick='showNestedUrlInfo()' class='link-store-scope' /> </label></td><td><input type='checkbox' class='mrewrite' " + checked + " /></td></tr>";
        }

        html += "<tr><td></td><td><button onclick='saveItemChanges(this)' type='button'>Update Item</button></td></tr>";


        html += '</table></div></div>';
        return html;
    }

    function saveItemChanges(btn) {
        var listItem = jQuery(btn).closest('li.menuitem');
        var originalTitle = listItem.attr('mtitle');

        listItem.attr('mtitle', listItem.find('input.mtitle').first().val());

        listItem.attr('murl', listItem.find('input.murl').first().val());

        var rewrite = 0;
        if(listItem.find('input.mrewrite').first().is(':checked')){
            rewrite = 1;
        }
        listItem.attr('mrewrite', rewrite);

        var useCustomTitle = listItem.find('input.useCustomTitle').is(':checked');
        if(listItem.attr('mtype') == 3){
            useCustomTitle = true;
        }
        if(useCustomTitle){
            listItem.attr('usecustomtitle','1');
        }else{
            listItem.attr('usecustomtitle','0');
        }
        
        var titleText = listItem.find('input.mtitle').first().val();
        if(!useCustomTitle){
            titleText = listItem.attr('moriginaltitle');
        }
        var title = listItem.find('span.title').first().text(titleText);

        showMenuMessage("Item successfully updated", "success");

        setTimeout(function() {
            hideMenuMessage();
        },5000)

        if(title.text() != originalTitle) {
            title.addClass('animated fadeIn');
            setTimeout(function() {
                title.removeClass('animated fadeIn');
            },3000)
        }
    }

    function addCmsPages() {
        jQuery('.dropLocation').remove();

        //get checked values
        var pageIds = easymenu_cms_page_grid_massactionJsObject.getCheckedValues();

        var idsArray = explode(',', pageIds);

        var sortableHtml = '';
        for(i = 0;i < idsArray.length; i++){
            if(idsArray[i] == ""){
                continue;
            }
            sortableHtml += getItemHtml(2,idsArray[i],cmsPageDetails[idsArray[i]].title,cmsPageDetails[idsArray[i]].url);
        }

        itemsToDrop = sortableHtml;
        currentGrid = 'easymenu_cms_page';

        showDropLocations();
    }

    function addProducts() {
       jQuery('.dropLocation').remove();

        //get checked values
        var productIds = easymenu_select_products_grid_massactionJsObject.getCheckedValues();

        var idsArray = explode(',', productIds);

        var sortableHtml = '';
        for(i = 0;i < idsArray.length; i++){
            if(idsArray[i] == ""){
                continue;
            }
            sortableHtml += getItemHtml(4,idsArray[i],productDetails[idsArray[i]].name,productDetails[idsArray[i]].url_key);
        }

        itemsToDrop = sortableHtml;
        currentGrid = 'easymenu_select_products';

        showDropLocations();

    }

    function addCategories() {
        jQuery('.dropLocation').remove();

        //get checked values
        var catIds = jQuery('#product_categories').val();

        var ids = explode(',', catIds);

        //filter out duplicates
        var idsArray = [];
        ids.forEach(function(item) {
            if(item == ""){
                return;
            }
            if(idsArray.indexOf(item) < 0) {
                idsArray.push(item);
            }
        });

        if(!idsArray.length){
            return;
        }


        var sortableHtml = '';
        for(i = 0;i < idsArray.length; i++){
            if(idsArray[i] == ""){
                continue;
            }
            sortableHtml += getItemHtml(1,idsArray[i],categoryDetails[idsArray[i]].name,categoryDetails[idsArray[i]].url_key);
        }

        itemsToDrop = sortableHtml;

        currentGrid = 'categories';

        showDropLocations();
    }

    function addCustomLink(){
        if(jQuery('#cLinkTitle').val() == ""){
            jQuery('#cLinkTitle')
                .css('border-color', 'rgb(240, 82, 82)')
                .css('background-color', '#FFF2F2')

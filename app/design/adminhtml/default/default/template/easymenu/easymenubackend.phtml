    }

    function getItemHtml(type,typeId,name,url) {
        var cssClass;
        if(type === 1){
            cssClass = 'cat';
        }
        if(type === 2){
            cssClass = 'cms';
        }
        if(type === 3){
            cssClass = 'link';
        }
        if(type === 4){
            cssClass = 'product';
        }
        return '<li class="' + cssClass + ' animated pulse menuitem" mtitle="' + name + '" moriginaltitle="' + name + '" mtype="' + type + '" mid="' + typeId + '" murl="' + url + '" mrewrite="0" usecustomtitle="0" style="display: list-item;"><div><span class="title">' + name +'</span>' + getToolButtons() +'</div></li>';
    }

    function getToolButtons() {
        var buttons = "<div class='tbuttonwrap'>";
        buttons    +=  "<div class='tbutton remove' onclick='removeItem(this)'><i class='fa fa-times'></i></div>";
        buttons    +=  "<div class='tbutton edit' onclick='showItemDetails(this)'><i class='fa fa-pencil'></i></div>";
        buttons    += "</div>";
        return buttons;
    }

    function removeItem(btn){
        btn = jQuery(btn);
        //get list item
        var listItem = btn.closest('li.menuitem');
        if(listItem.find('li.menuitem').length){
            //has children
            var sibl = listItem.prev();
            if(sibl.length){
                //move children to sibling
                if(sibl.children('ol').length == 0){
                    sibl.append('<ol />');
                }
                listItem.children('ol').children().appendTo(sibl.children('ol'));
            }else{
                //move children to parent
                var prnt = listItem.closest('ol');
                listItem.children('ol').children().appendTo(prnt);
            }
        }

        listItem.remove();

    }

    function showDropLocations(){
        showMenuMessage("Move your mouse over the menu below to insert the new item(s) or <a href='#' onclick='cancelAdd()'>cancel</a>.", 'notice');
        jQuery('.mItemDetails').remove();
        jQuery('#smenu li>div').after("<div class='dropLocation' style='display:none'><span onclick='addSiblingAbove(this)' class='droplink'><i class='icon-up-thin'></i> Insert above</span>  <span onclick='addSiblingBelow(this)' class='droplink'><i class='icon-down-thin'></i> Insert below</span> <span onclick='addChild(this)' class='droplink' style='float:right;'><i class='icon-level-down-1'></i> Insert as sub item</span></div>")
        jQuery('#smenu li>div').each(function() {
            jQuery(this).mouseenter(function() {
                jQuery(this).next('.dropLocation').show();
            });
            jQuery(this).mouseleave(function() {
                jQuery(this).next('.dropLocation').hide();
            });
        })
        jQuery('.dropLocation').mouseenter(function() {
            jQuery(this).show();
        })
        jQuery('.dropLocation').mouseleave(function() {
            jQuery(this).hide();
        });

        //if no menu items exist
        if(!jQuery('#smenu ol').children().length){
            jQuery('#smenu').append('<ol>' + itemsToDrop + '</ol>');
            successAddMsg();
            refreshGrid();
        }
    }

    function addChild(location) {
        var mItem = jQuery(location).parent();
        if(mItem.next().is('ol')){
            mItem.next().prepend(itemsToDrop);
        }else{
            mItem.after('<ol>' + itemsToDrop + '</ol>');
        }
        jQuery('.dropLocation').remove();
        successAddMsg();
        refreshGrid();
    }

    function addSiblingAbove(location) {
        var mItem = jQuery(location).parents('li').eq(0);
        mItem.before(itemsToDrop);
        jQuery('.dropLocation').remove();
        successAddMsg();
        refreshGrid();
    }

    function addSiblingBelow(location) {
        var mItem = jQuery(location).parents('li').eq(0);
        mItem.after(itemsToDrop);
        jQuery('.dropLocation').remove();
        successAddMsg();
        refreshGrid();
    }

    function successAddMsg() {
        showMenuMessage("Successfully added the new item(s) to the menu!", 'success');
        setTimeout(function() {
            jQuery('#smenu .animated').removeClass('animated').removeClass('pulse');

    function loadDefaultCategories() {
        var c = confirm("Are you sure? This will replace the existing menu with the default category menu for this store view.");
        if(c == true) {
            jQuery('#smenu>ol').remove();
            jQuery('#smenu').append(jQuery('#defaultCategories').html());
            jQuery('#smenu span.title').after(getToolButtons());
            showMenuMessage("Menu successfully updated",'success');
            jQuery('#smenu>ol').addClass('animated fadeIn');
            setTimeout(function() {
                jQuery('#smenu>ol').removeClass('animated fadeIn');
                hideMenuMessage();
            },4000)
        }
    }

    function copyStoreMenu() {
        var c = confirm("Are you sure? This will replace the existing menu with the menu of the selected store view.");

        if(c == true) {
            new Ajax.Request('<?php echo Mage::helper("adminhtml")->getUrl('*/*/copystoremenu', array('_current'=>true)); ?>',{
                parameters: {fromStore: <?php echo $this->getStoreId();?>,toStore:jQuery('#loadStoreMenu').val()},
                onComplete: function(response) {
                    var response = jQuery.parseJSON(response.responseText);

                    //show message
                    showMenuMessage(response.message,response.status);
                    setTimeout(function() {
                        hideMenuMessage();
                    },4000)

                    //update menu
                    if(typeof response.html !== "undefined"){
                        jQuery('#smenu>ol').remove();
                        jQuery('#smenu').append(response.html);
                        jQuery('#smenu span.title').after(getToolButtons());
                        jQuery('#smenu>ol').addClass('animated fadeIn');
                        setTimeout(function() {
                            jQuery('#smenu>ol').removeClass('animated fadeIn');
                        },4000)
                    }
                }
            });
        }
    }

    function cancelAdd() {
        jQuery('.dropLocation').remove();
